---
import { getProjectPath, projects } from "../data/portfolio";
import { copy } from "../i18n/copy";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title={copy.archive.metadataTitle}
  description={copy.archive.metadataDescription}
  pageClass="archive-page"
  homeHref="/"
>
  <main id="top" class="archive-shell">
    <a class="archive-back" href="/#projects">
      <span class="archive-back-arrow" aria-hidden="true">←</span>
      <span data-en={copy.archive.back.en} data-zh={copy.archive.back.zh}>{copy.archive.back.en}</span>
    </a>

    <header class="archive-hero reveal">
      <p class="archive-eyebrow" data-en={copy.archive.eyebrow.en} data-zh={copy.archive.eyebrow.zh}>
        {copy.archive.eyebrow.en}
      </p>
      <h1 id="archive-title" data-en={copy.archive.title.en} data-zh={copy.archive.title.zh}>{copy.archive.title.en}</h1>
      <p data-en={copy.archive.description.en} data-zh={copy.archive.description.zh}>{copy.archive.description.en}</p>
    </header>

    <section class="archive-index" aria-labelledby="archive-title">
      <div class="archive-table-heading" aria-hidden="true">
        <span data-en={copy.archive.number.en} data-zh={copy.archive.number.zh}>{copy.archive.number.en}</span>
        <span data-en={copy.archive.project.en} data-zh={copy.archive.project.zh}>{copy.archive.project.en}</span>
        <span data-en={copy.archive.technologies.en} data-zh={copy.archive.technologies.zh}>
          {copy.archive.technologies.en}
        </span>
        <span data-en={copy.archive.links.en} data-zh={copy.archive.links.zh}>{copy.archive.links.en}</span>
      </div>

      <ol class="archive-list">
        {projects.map((project, index) => (
            <li class="archive-row reveal" data-project-href={getProjectPath(project.id)}>
              <span class="archive-number">{String(index + 1).padStart(2, "0")}</span>
              <div class="archive-project-summary">
                <a class="archive-project-title" href={getProjectPath(project.id)}>
                  <span>{project.title}</span>
                  <span class="link-arrow link-arrow-forward" aria-hidden="true">→</span>
                </a>
                <p data-en={project.cardLabel.en} data-zh={project.cardLabel.zh}>{project.cardLabel.en}</p>
              </div>
              <ul class="tag-list archive-tag-list" aria-label={`${project.title} technologies`}>
                {project.tags.map((tag) => <li class="tag">{tag.label}</li>)}
              </ul>
              <div class="archive-row-actions">
                <a class="text-link" href={getProjectPath(project.id)}>
                  <span data-en={copy.archive.details.en} data-zh={copy.archive.details.zh}>{copy.archive.details.en}</span>
                  <span class="link-arrow link-arrow-forward" aria-hidden="true">→</span>
                </a>
                {project.github && (
                  <a class="text-link" href={project.github} target="_blank" rel="noreferrer">
                    GitHub <span class="link-arrow link-arrow-external" aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </li>
        ))}
      </ol>
    </section>
  </main>
</BaseLayout>
