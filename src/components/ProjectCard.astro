---
import type { Project } from "../data/portfolio";
import { getProjectPath } from "../data/portfolio";
import { copy } from "../i18n/copy";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const displayIndex = String(index + 1).padStart(2, "0");
const detailHref = getProjectPath(project.id);
---

<article class="project-card reveal" data-project-href={detailHref}>
  <div class:list={["project-media", project.mediaClass]} aria-hidden="true">
    <span class="project-media-index">{displayIndex}</span>
    <div class="media-placeholder">
      <strong>{project.mediaBadge}</strong>
      <small data-en={project.mediaHint.en} data-zh={project.mediaHint.zh}>{project.mediaHint.en}</small>
    </div>
  </div>

  <div class="project-content">
    <p class="project-kicker" data-en={project.cardLabel.en} data-zh={project.cardLabel.zh}>{project.cardLabel.en}</p>
    <h3>{project.title}</h3>
    <p class="project-description" data-en={project.description.en} data-zh={project.description.zh}>
      {project.description.en}
    </p>
    <ul class="tag-list" aria-label={`${project.title} technologies`}>
      {project.tags.map((tag) => <li class="tag">{tag.label}</li>)}
    </ul>
    <div class="project-actions">
      <a class="text-link project-detail-link" href={detailHref}>
        <span data-en={copy.projects.details.en} data-zh={copy.projects.details.zh}>{copy.projects.details.en}</span>
        <span class="link-arrow link-arrow-forward" aria-hidden="true">→</span>
      </a>
      {project.github && (
        <a class="text-link" href={project.github} target="_blank" rel="noreferrer">
          GitHub <span class="link-arrow link-arrow-external" aria-hidden="true">↗</span>
        </a>
      )}
    </div>
  </div>
</article>
