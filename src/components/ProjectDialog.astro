---
import type { Project } from "../data/portfolio";
import { copy } from "../i18n/copy";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const closeLabel = {
  en: `Close ${project.title} details`,
  zh: `关闭 ${project.title} 详情`
};
---

<dialog id={`${project.id}-dialog`} class="project-dialog">
  <button
    class="dialog-close"
    type="button"
    aria-label={closeLabel.en}
    data-aria-en={closeLabel.en}
    data-aria-zh={closeLabel.zh}
  >×</button>
  <div class:list={["dialog-media", project.mediaClass]}>
    <span data-en={project.mediaLabel.en} data-zh={project.mediaLabel.zh}>{project.mediaLabel.en}</span>
  </div>
  <div class="dialog-content">
    <p class="eyebrow" data-en={project.dialogType.en} data-zh={project.dialogType.zh}>{project.dialogType.en}</p>
    <h2>{project.dialogTitle}</h2>
    <dl class="project-meta">
      {project.metadata.map((item) => (
        <div>
          <dt data-en={item.label.en} data-zh={item.label.zh}>{item.label.en}</dt>
          <dd data-en={item.value.en} data-zh={item.value.zh}>{item.value.en}</dd>
        </div>
      ))}
    </dl>
    <h3 data-en={project.detailHeading.en} data-zh={project.detailHeading.zh}>{project.detailHeading.en}</h3>
    <ul>
      {project.details.map((detail) => <li data-en={detail.en} data-zh={detail.zh}>{detail.en}</li>)}
    </ul>
    {project.github && (
      <a
        class="button button-primary"
        href={project.github}
        target="_blank"
        rel="noreferrer"
        data-en={copy.projects.openGithub.en}
        data-zh={copy.projects.openGithub.zh}
      >
        {copy.projects.openGithub.en}
      </a>
    )}
  </div>
</dialog>
